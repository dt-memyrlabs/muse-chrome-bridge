{
  "manifest_version": 3,
  "name": "Muse Chrome Bridge",
  "version": "2.8.0",
  "description": "Give tabs to a Muse chat. One confirmation gives that chat full control of the tabs you give it — and only those tabs.",
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_title": "Muse Chrome Bridge"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "sidePanel",
    "notifications",
    "debugger",
    "webNavigation",
    "clipboardWrite",
    "nativeMessaging",
    "scripting",
    "offscreen"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "host_permissions": [
    "<all_urls>"
  ]
}
